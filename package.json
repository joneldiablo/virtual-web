{
  "name": "virtual-web-browser",
  "version": "1.0.2",
  "description": "Virtual Web Browser",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/cjs/index.js",
  "bin": {
    "vwb": "./bin/main.bundle.js"
  },
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts",
      "source": "./src/js/index.ts"
    },
    "./clipboard": {
      "import": "./dist/esm/clipboard.js",
      "require": "./dist/cjs/clipboard.js",
      "types": "./dist/types/clipboard.d.ts",
      "source": "./src/js/clipboard.ts"
    },
    "./http-server": {
      "import": "./dist/esm/http-server.js",
      "require": "./dist/cjs/http-server.js",
      "types": "./dist/types/http-server.d.ts",
      "source": "./src/js/http-server.ts"
    },
    "./index": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts",
      "source": "./src/js/index.ts"
    },
    "./keyboard": {
      "import": "./dist/esm/keyboard.js",
      "require": "./dist/cjs/keyboard.js",
      "types": "./dist/types/keyboard.d.ts",
      "source": "./src/js/keyboard.ts"
    },
    "./mouse": {
      "import": "./dist/esm/mouse.js",
      "require": "./dist/cjs/mouse.js",
      "types": "./dist/types/mouse.d.ts",
      "source": "./src/js/mouse.ts"
    },
    "./remote-browser": {
      "import": "./dist/esm/remote-browser.js",
      "require": "./dist/cjs/remote-browser.js",
      "types": "./dist/types/remote-browser.d.ts",
      "source": "./src/js/remote-browser.ts"
    },
    "./ws-multi": {
      "import": "./dist/esm/ws-multi.js",
      "require": "./dist/cjs/ws-multi.js",
      "types": "./dist/types/ws-multi.d.ts",
      "source": "./src/js/ws-multi.ts"
    },
    "./ws-server": {
      "import": "./dist/esm/ws-server.js",
      "require": "./dist/cjs/ws-server.js",
      "types": "./dist/types/ws-server.d.ts",
      "source": "./src/js/ws-server.ts"
    },
    "./ws-single": {
      "import": "./dist/esm/ws-single.js",
      "require": "./dist/cjs/ws-single.js",
      "types": "./dist/types/ws-single.d.ts",
      "source": "./src/js/ws-single.ts"
    }
  },
  "files": [
    "dist/**",
    "bin/**",
    "public/**",
    "src/**",
    "tsconfig.json",
    "tsconfig.esm.json",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "src": "src"
  },
  "scripts": {
    "start": "ENV=PROD node dist/cjs/cli.js",
    "start:dev": "ENV=DEV dotenv -e .env -- ts-node-dev --respawn --transpile-only src/cli.ts",
    "start:debug": "ENV=DEBUG dotenv -e .env -- node dist/cjs/cli.js",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:bin": "rm -rf bin/* && webpack",
    "build": "rm -rf dist/* && yarn build:cjs && yarn build:esm && yarn build:bin && typedoc",
    "test": "jest",
    "test:e2e": "jest --config ./e2e/jest-e2e.json --forceExit",
    "release": "./release.sh"
  },
  "author": "joneldiablo",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "express-ws": "^5.0.2",
    "puppeteer": "^24.16.2",
    "ws": "^8.18.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-ws": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.9",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/ws": "^8.18.1",
    "babel-jest": "^29.7.0",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "terser": "^5.36.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-shell-plugin-next": "^2.3.2"
  }
}